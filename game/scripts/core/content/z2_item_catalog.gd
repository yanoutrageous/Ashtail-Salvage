static func all_items() -> Array[Dictionary]:
	var result := collectibles()
	result.append_array(supplies())
	return result


static func collectibles() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for row: Dictionary in COLLECTIBLE_ROWS:
		result.append(_definition(row, "S5", "42件藏品总表"))
	return result


static func supplies() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for row: Dictionary in SUPPLY_ROWS:
		result.append(_definition(row, "S4", "30件物资总表"))
	return result


static func definition(item_id: String) -> Dictionary:
	for row: Dictionary in COLLECTIBLE_ROWS:
		if row.item_id == item_id:
			return _definition(row, "S5", "42件藏品总表")
	for row: Dictionary in SUPPLY_ROWS:
		if row.item_id == item_id:
			return _definition(row, "S4", "30件物资总表")
	return {}


static func _definition(row: Dictionary, source_id: String, sheet: String) -> Dictionary:
	var kind := str(row.item_type)
	var result := {
		"content_version": CONTENT_VERSION,
		"main_type": StringName(kind), "item_type": StringName(kind),
		"rarity": StringName("tier_%d" % int(row.tier)),
		"collectible_level": int(row.tier) if kind == "collectible" else 0,
		"can_equip": kind == "equipment", "can_consume": kind == "consumable",
		"can_sell": kind == "collectible", "can_store": true, "is_unique": false,
		"value_state": "known_value" if kind == "collectible" else "purchase_price_only",
		"source_id": source_id, "source_sheet": sheet, "source_hash": SOURCE_HASHES[source_id],
		"effect_kind": "", "effect_amount": 0, "effect_params": {}, "equipment_slot": "",
		"required_research_id": "", "map_ids": [], "channels_status": "confirmed",
		"art_status": "runtime_verified", "tags": [kind, "z2"],
	}
	result.merge(row.duplicate(true), true)
	return result
